#!/usr/bin/env sh
# openpreset — Core CLI manager and auto-updater for openpreset router suite.
set -eu

_resolve_self() {
    _target="${1}"
    while [ -h "${_target}" ]; do
        _dir=$(cd -P "$(dirname "${_target}")" && pwd)
        _target=$(readlink "${_target}")
        case "${_target}" in
            /*) : ;;
            *) _target="${_dir}/${_target}" ;;
        esac
    done
    _dir=$(cd -P "$(dirname "${_target}")" && pwd)
    printf '%s/%s\n' "${_dir}" "$(basename "${_target}")"
}

_find_router_dir() {
    _THIS=$(_resolve_self "$0")
    _THIS_DIR=$(dirname "${_THIS}")
    _THIS_PARENT_DIR=$(dirname "${_THIS_DIR}")

    if [ -d "${_THIS_PARENT_DIR}/router" ]; then
        printf '%s\n' "${_THIS_PARENT_DIR}/router"
        return 0
    fi
    if [ -d "${_THIS_PARENT_DIR}/share/openpreset/router" ]; then
        printf '%s\n' "${_THIS_PARENT_DIR}/share/openpreset/router"
        return 0
    fi
    if [ -d "${HOME}/.local/share/openpreset/router" ]; then
        printf '%s\n' "${HOME}/.local/share/openpreset/router"
        return 0
    fi
    if [ -d "/usr/local/share/openpreset/router" ]; then
        printf '%s\n' "/usr/local/share/openpreset/router"
        return 0
    fi
    return 1
}

_ROUTER_PATH=$(_find_router_dir 2>/dev/null || true)
if [ -n "${_ROUTER_PATH}" ] && [ -f "${_ROUTER_PATH}/config.sh" ]; then
    export _ROUTER_DIR="${_ROUTER_PATH}"
    . "${_ROUTER_DIR}/config.sh"
    . "${_ROUTER_DIR}/utils.sh"
fi

VERSION="${OPENPRESET_VERSION:-1.0.0}"
REPO="${OPENPRESET_REPO:-zaidsubhani135/claude-router}"

_cmd="${1:-help}"
if [ $# -gt 0 ]; then
    shift
fi

case "${_cmd}" in
    version|-v|--version)
        printf '%s\n' "openpreset v${VERSION}"
        exit 0
        ;;

    update|upgrade)
        _force=false
        for _arg in "$@"; do
            case "${_arg}" in
                -f|--force)
                    _force=true
                    ;;
            esac
        done

        printf '%s\n' "Checking for new updates..."

        _tmp_dir=$(mktemp -d)
        cleanup() { rm -rf "${_tmp_dir}"; }
        trap cleanup EXIT INT TERM

        _install_url="https://raw.githubusercontent.com/${REPO}/main/install.sh"
        if ! curl -fsSL "${_install_url}" -o "${_tmp_dir}/install.sh" 2>/dev/null; then
            printf '%s\n' "❌ Failed to download update script from GitHub repository." >&2
            exit 1
        fi
        chmod +x "${_tmp_dir}/install.sh"

        _api_url="https://api.github.com/repos/${REPO}/releases/latest"
        _latest_tag=""
        _api_json=$(curl -fsSL "${_api_url}" 2>/dev/null || true)
        if [ -n "${_api_json}" ]; then
            if command -v jq >/dev/null 2>&1; then
                _latest_tag=$(printf '%s' "${_api_json}" | jq -r '.tag_name // empty' 2>/dev/null || true)
            fi
            if [ -z "${_latest_tag}" ]; then
                _latest_tag=$(printf '%s' "${_api_json}" | grep -o '"tag_name": *"[^"]*"' | sed 's/.*"tag_name": *"\([^"]*\)".*/\1/' 2>/dev/null || true)
            fi
        fi

        if [ -z "${_latest_tag}" ]; then
            _latest_tag=$(sed -n 's/^VERSION="\([^"]*\)"/\1/p' "${_tmp_dir}/install.sh" 2>/dev/null || true)
        fi

        _curr_v="${VERSION#v}"
        _latest_v="${_latest_tag#v}"

        if [ -z "${_latest_v}" ]; then
            _latest_v="${_curr_v}"
        fi

        if [ "${_curr_v}" = "${_latest_v}" ] && [ "${_force}" = "false" ]; then
            printf '%s\n' "Already the newest version v${_curr_v}"
            exit 0
        fi

        if [ "${_curr_v}" != "${_latest_v}" ]; then
            printf '%s\n' "New version found: v${_latest_v}"
        fi

        printf '%s\n' "Updating..."
        if sh "${_tmp_dir}/install.sh" >"${_tmp_dir}/install.log" 2>&1; then
            printf '%s\n' "✅ Successfully updated to v${_latest_v}"
        else
            printf '%s\n' "❌ Update failed:" >&2
            cat "${_tmp_dir}/install.log" >&2
            exit 1
        fi
        exit 0
        ;;

    export|backup-export)
        _target_path=""
        for _arg in "$@"; do
            case "${_arg}" in
                *)
                    if [ -z "${_target_path}" ]; then
                        _target_path="${_arg}"
                    fi
                    ;;
            esac
        done

        _today=$(date +%Y-%m-%d)
        if [ -z "${_target_path}" ] || [ "${_target_path}" = "~" ]; then
            _target_file="${HOME}/openpreset-backup-${_today}.json"
        else
            _target_path=$(printf '%s\n' "${_target_path}" | sed "s|^~|${HOME}|")
            if [ -d "${_target_path}" ]; then
                _target_file="${_target_path%/}/openpreset-backup-${_today}.json"
            else
                _target_file="${_target_path}"
            fi
        fi

        if [ -n "${_ROUTER_PATH:-}" ] && [ -f "${_ROUTER_DIR}/router_engine.sh" ]; then
            . "${_ROUTER_DIR}/router_engine.sh"
            backup_export "${_target_file}"
        else
            printf '%s\n' "❌ Router components not found." >&2
            exit 1
        fi
        exit 0
        ;;

    import|backup-import)
        _target_path=""
        _mode="merge"
        while [ $# -gt 0 ]; do
            case "${1}" in
                --mode)
                    _mode="${2:-merge}"
                    shift 2
                    ;;
                --mode=*)
                    _mode="${1#*=}"
                    shift
                    ;;
                *)
                    if [ -z "${_target_path}" ]; then
                        _target_path="${1}"
                    fi
                    shift
                    ;;
            esac
        done

        _today=$(date +%Y-%m-%d)
        if [ -z "${_target_path}" ] || [ "${_target_path}" = "~" ]; then
            if [ -f "${HOME}/openpreset-backup-${_today}.json" ]; then
                _target_file="${HOME}/openpreset-backup-${_today}.json"
            else
                _latest=$(find "${HOME}" -maxdepth 1 -name 'openpreset-backup-*.json' 2>/dev/null | sort -r | head -n 1 || true)
                if [ -n "${_latest}" ]; then
                    _target_file="${_latest}"
                else
                    _target_file="${HOME}/openpreset-backup-${_today}.json"
                fi
            fi
        else
            _target_path=$(printf '%s\n' "${_target_path}" | sed "s|^~|${HOME}|")
            _target_file="${_target_path}"
        fi

        if [ -n "${_ROUTER_PATH:-}" ] && [ -f "${_ROUTER_DIR}/router_engine.sh" ]; then
            . "${_ROUTER_DIR}/router_engine.sh"
            backup_import "${_target_file}" "${_mode}"
        else
            printf '%s\n' "❌ Router components not found." >&2
            exit 1
        fi
        exit 0
        ;;

    reset)
        _yes=false
        for _arg in "$@"; do
            case "${_arg}" in
                -y|--yes) _yes=true ;;
            esac
        done

        if [ "${_yes}" = "false" ]; then
            printf 'Are you sure you want to reset openpreset user data and cache? [y/N] '
            read -r _ans
            case "$(printf '%s' "${_ans}" | tr '[:upper:]' '[:lower:]')" in
                y|yes) ;;
                *) printf '%s\n' "Reset cancelled."; exit 0 ;;
            esac
        fi

        _cfg="${XDG_CONFIG_HOME:-${HOME}/.config}/openpreset"
        _legacy_cfg="${XDG_CONFIG_HOME:-${HOME}/.config}/claude-router"
        _cache="${XDG_CACHE_HOME:-${HOME}/.cache}/openpreset"

        rm -rf "${_cfg}" "${_legacy_cfg}" "${_cache}"
        printf '%s\n' "✅ openpreset user data and cache reset successfully."
        exit 0
        ;;

    refresh)
        _cache="${XDG_CACHE_HOME:-${HOME}/.cache}/openpreset"
        rm -rf "${_cache}"
        printf '%s\n' "✅ openpreset model and provider cache refreshed."
        exit 0
        ;;

    uninstall)
        _remove_data=false
        _yes=false
        for _arg in "$@"; do
            case "${_arg}" in
                -r|--remove-data) _remove_data=true ;;
                -y|--yes) _yes=true ;;
            esac
        done

        if [ "${_yes}" = "false" ]; then
            if [ "${_remove_data}" = "true" ]; then
                printf 'Are you sure you want to uninstall openpreset and delete all user data and cache? [y/N] '
            else
                printf 'Are you sure you want to uninstall openpreset? [y/N] '
            fi
            read -r _ans
            case "$(printf '%s' "${_ans}" | tr '[:upper:]' '[:lower:]')" in
                y|yes) ;;
                *) printf '%s\n' "Uninstall cancelled."; exit 0 ;;
            esac
        fi

        _THIS=$(_resolve_self "$0")
        _THIS_DIR=$(dirname "${_THIS}")

        # Locate binaries and share dir
        _bin_dirs="${_THIS_DIR} ${HOME}/.local/bin /usr/local/bin"
        _launchers="cr kr hr or pr clr openpreset"

        for _d in ${_bin_dirs}; do
            [ -d "${_d}" ] || continue
            for _l in ${_launchers}; do
                if [ -f "${_d}/${_l}" ]; then
                    rm -f "${_d}/${_l}" 2>/dev/null || true
                fi
            done
        done

        _share_dirs="${HOME}/.local/share/openpreset /usr/local/share/openpreset $(dirname "${_THIS_DIR}")/share/openpreset"
        for _sd in ${_share_dirs}; do
            if [ -d "${_sd}" ]; then
                rm -rf "${_sd}" 2>/dev/null || true
            fi
        done

        if [ "${_remove_data}" = "true" ]; then
            _cfg="${XDG_CONFIG_HOME:-${HOME}/.config}/openpreset"
            _legacy_cfg="${XDG_CONFIG_HOME:-${HOME}/.config}/claude-router"
            _cache="${XDG_CACHE_HOME:-${HOME}/.cache}/openpreset"
            rm -rf "${_cfg}" "${_legacy_cfg}" "${_cache}"
            printf '%s\n' "✅ openpreset tool and user data deleted successfully."
        else
            printf '%s\n' "✅ openpreset tool uninstalled successfully."
        fi
        exit 0
        ;;

    help|-h|--help)
        cat <<EOF
openpreset v${VERSION} — OpenRouter model & preset manager for top AI coding agents

USAGE:
    openpreset [command] [options]
    cr | kr | hr | or | pr | clr [args...]

LAUNCHERS:
    cr            Launch Claude Code (claude)
    kr            Launch Kilo Code (kilo)
    hr            Launch Hermes Agent (hermes)
    or            Launch OpenClaw (openclaw)
    pr            Launch Pi Agent (pi)
    clr           Launch Cline (cline)

COMMANDS:
    update [--force|-f]              Check for updates and install latest release
    export [<path>]                  Export user models and presets (default: ~)
    import [<path>] [--mode <mode>]  Import user models and presets (default: ~)
    reset [-y]                       Reset user configuration, presets, and cache
    refresh                          Clear model and provider cache
    uninstall [-r] [-y]              Uninstall openpreset tool (-r to delete user data)
    version                          Print openpreset version
    help                             Show this help message

ENVIRONMENT:
    OPENROUTER_API_KEY   OpenRouter API token (or ANTHROPIC_AUTH_TOKEN)
EOF
        exit 0
        ;;

    *)
        printf '%s\n' "Unknown command: ${_cmd}" >&2
        printf '%s\n' "Run 'openpreset --help' for usage." >&2
        exit 1
        ;;
esac
