#!/usr/bin/env sh
# openpreset — Core CLI manager and auto-updater for openpreset router suite.
set -eu

_resolve_self() {
    _target="${1}"
    while [ -h "${_target}" ]; do
        _dir=$(cd -P "$(dirname "${_target}")" && pwd)
        _target=$(readlink "${_target}")
        case "${_target}" in
            /*) : ;;
            *) _target="${_dir}/${_target}" ;;
        esac
    done
    _dir=$(cd -P "$(dirname "${_target}")" && pwd)
    printf '%s/%s\n' "${_dir}" "$(basename "${_target}")"
}

_find_router_dir() {
    _THIS=$(_resolve_self "$0")
    _THIS_DIR=$(dirname "${_THIS}")
    _THIS_PARENT_DIR=$(dirname "${_THIS_DIR}")

    if [ -d "${_THIS_PARENT_DIR}/router" ]; then
        printf '%s\n' "${_THIS_PARENT_DIR}/router"
        return 0
    fi
    if [ -d "${_THIS_PARENT_DIR}/share/openpreset/router" ]; then
        printf '%s\n' "${_THIS_PARENT_DIR}/share/openpreset/router"
        return 0
    fi
    if [ -d "${HOME}/.local/share/openpreset/router" ]; then
        printf '%s\n' "${HOME}/.local/share/openpreset/router"
        return 0
    fi
    if [ -d "/usr/local/share/openpreset/router" ]; then
        printf '%s\n' "/usr/local/share/openpreset/router"
        return 0
    fi
    return 1
}

_ROUTER_PATH=$(_find_router_dir 2>/dev/null || true)
if [ -n "${_ROUTER_PATH}" ] && [ -f "${_ROUTER_PATH}/config.sh" ]; then
    export _ROUTER_DIR="${_ROUTER_PATH}"
    . "${_ROUTER_DIR}/config.sh"
    . "${_ROUTER_DIR}/utils.sh"
fi

VERSION="${OPENPRESET_VERSION:-1.0.0}"
REPO="${OPENPRESET_REPO:-zaidsubhani135/claude-router}"

_cmd="${1:-help}"
if [ $# -gt 0 ]; then
    shift
fi

case "${_cmd}" in
    version|-v|--version)
        printf '%s\n' "openpreset v${VERSION}"
        exit 0
        ;;

    update|upgrade)
        _force=false
        for _arg in "$@"; do
            case "${_arg}" in
                -f|--force)
                    _force=true
                    ;;
            esac
        done

        printf '%s\n' "Checking for new updates..."

        _tmp_dir=$(mktemp -d)
        cleanup() { rm -rf "${_tmp_dir}"; }
        trap cleanup EXIT INT TERM

        _install_url="https://raw.githubusercontent.com/${REPO}/main/install.sh"
        if ! curl -fsSL "${_install_url}" -o "${_tmp_dir}/install.sh" 2>/dev/null; then
            printf '%s\n' "❌ Failed to download update script from GitHub repository." >&2
            exit 1
        fi
        chmod +x "${_tmp_dir}/install.sh"

        _api_url="https://api.github.com/repos/${REPO}/releases/latest"
        _latest_tag=""
        _api_json=$(curl -fsSL "${_api_url}" 2>/dev/null || true)
        if [ -n "${_api_json}" ]; then
            if command -v jq >/dev/null 2>&1; then
                _latest_tag=$(printf '%s' "${_api_json}" | jq -r '.tag_name // empty' 2>/dev/null || true)
            fi
            if [ -z "${_latest_tag}" ]; then
                _latest_tag=$(printf '%s' "${_api_json}" | grep -o '"tag_name": *"[^"]*"' | sed 's/.*"tag_name": *"\([^"]*\)".*/\1/' 2>/dev/null || true)
            fi
        fi

        if [ -z "${_latest_tag}" ]; then
            _latest_tag=$(sed -n 's/^VERSION="\([^"]*\)"/\1/p' "${_tmp_dir}/install.sh" 2>/dev/null || true)
        fi

        _curr_v="${VERSION#v}"
        _latest_v="${_latest_tag#v}"

        if [ -z "${_latest_v}" ]; then
            _latest_v="${_curr_v}"
        fi

        if [ "${_curr_v}" = "${_latest_v}" ] && [ "${_force}" = "false" ]; then
            printf '%s\n' "Already the newest version v${_curr_v}"
            exit 0
        fi

        if [ "${_curr_v}" != "${_latest_v}" ]; then
            printf '%s\n' "New version found: v${_latest_v}"
        fi

        printf '%s\n' "Updating..."
        if sh "${_tmp_dir}/install.sh" >"${_tmp_dir}/install.log" 2>&1; then
            printf '%s\n' "✅ Successfully updated to v${_latest_v}"
        else
            printf '%s\n' "❌ Update failed:" >&2
            cat "${_tmp_dir}/install.log" >&2
            exit 1
        fi
        exit 0
        ;;

    launch|run)
        if [ $# -eq 0 ]; then
            printf '%s\n' "Usage: openpreset launch <agent> [args...]" >&2
            printf '%s\n' "Agents: cr (claude), kr (kilo), hr (hermes), or (openclaw), pr (pi), clr (cline)" >&2
            exit 1
        fi
        _agent="${1}"
        shift
        case "${_agent}" in
            cr|claude) exec cr "$@" ;;
            kr|kilo) exec kr "$@" ;;
            hr|hermes) exec hr "$@" ;;
            or|openclaw) exec or "$@" ;;
            pr|pi) exec pr "$@" ;;
            clr|cline) exec clr "$@" ;;
            *)
                if [ -n "${_ROUTER_PATH:-}" ]; then
                    . "${_ROUTER_DIR}/router_engine.sh"
                    export OPENPRESET_MODEL="__pick__"
                    openpreset_router || exit 1
                fi
                exec "${_agent}" "$@"
                ;;
        esac
        ;;

    help|-h|--help)
        cat <<EOF
openpreset v${VERSION} — OpenRouter model & preset manager for top AI coding agents

USAGE:
    openpreset [command] [options]
    cr | kr | hr | or | pr | clr [args...]

LAUNCHERS:
    cr            Launch Claude Code (claude)
    kr            Launch Kilo Code (kilo)
    hr            Launch Hermes Agent (hermes)
    or            Launch OpenClaw (openclaw)
    pr            Launch Pi Agent (pi)
    clr           Launch Cline (cline)

COMMANDS:
    update [--force|-f] Check for updates and install latest release
    version       Print openpreset version
    launch <agent> Launch specific agent with router settings
    help          Show this help message

ENVIRONMENT:
    OPENROUTER_API_KEY   OpenRouter API token (or ANTHROPIC_AUTH_TOKEN)
EOF
        exit 0
        ;;

    *)
        printf '%s\n' "Unknown command: ${_cmd}" >&2
        printf '%s\n' "Run 'openpreset --help' for usage." >&2
        exit 1
        ;;
esac
