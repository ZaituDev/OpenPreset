#!/usr/bin/env sh
# braining — brainstorming launcher (inactive example, extras/launchers/)
#
# Only launchers inside launchers/ are considered active. This file is an
# example of the sourced-launcher pattern; it works in place via:
#   . extras/launchers/braining
# To make it an active, discoverable launcher, copy or move it instead:
#   cp extras/launchers/braining launchers/braining
# Path resolution below is self-detecting and requires no edits either way.
# Sets behavioural env vars that persist in your shell session until
# `superpowers` (or a manual unset) clears them.
#
# Follows the minimal launcher contract (see extras/launchers/template):
#   1. set OPENPRESET_DEFAULT_MODELS
#   2. set OPENPRESET_MODEL
#   3. source router/router_engine.sh, call openpreset_router
#   4. exec claude (here: a slash-command, not raw passthrough)
# Everything else (default model list, behavioural env vars) is
# workflow-specific and owned entirely by this launcher, not the router.
#
# Portable POSIX sh — no zsh required. This file is meant to be SOURCED
# (". extras/launchers/braining" or ". launchers/braining"), so it does not
# set -e/-u itself — that would alter the caller's shell options. It also
# does not know its own path the way an executed script would ($0 would be
# the calling shell's own name when sourced), so BASH_SOURCE is used when
# available (bash/zsh), falling back to $0 for shells sourced via `.` where
# $0 is still meaningful (dash, some ksh builds). If neither works, set
# _ROUTER_DIR yourself before sourcing this file.

if [ -n "${BASH_SOURCE:-}" ]; then
    _BRAINING_SELF="${BASH_SOURCE}"
else
    _BRAINING_SELF="$0"
fi
_BRAINING_THIS_DIR=$(cd -P "$(dirname "${_BRAINING_SELF}")" && pwd)
_BRAINING_DIR_NAME=$(basename "${_BRAINING_THIS_DIR}")
_BRAINING_PARENT_DIR=$(dirname "${_BRAINING_THIS_DIR}")
_BRAINING_PARENT_NAME=$(basename "${_BRAINING_PARENT_DIR}")

if [ "${_BRAINING_DIR_NAME}" = 'launchers' ] && [ "${_BRAINING_PARENT_NAME}" = 'extras' ]; then
    _BRAINING_REPO_DIR=$(dirname "${_BRAINING_PARENT_DIR}")   # extras/launchers/braining -> repo root
else
    _BRAINING_REPO_DIR="${_BRAINING_PARENT_DIR}"              # launchers/braining        -> repo root
fi

export OPENROUTER_BASE_URL="${OPENROUTER_BASE_URL:-https://openrouter.ai/api/v1}"
export ANTHROPIC_BASE_URL="${ANTHROPIC_BASE_URL:-${OPENROUTER_BASE_URL}}"

# ── Default model list ───────────────────────────────────────────────────────
# Newline-joined string (POSIX sh has no arrays). User additions are managed
# interactively or stored in $XDG_CONFIG_HOME/openpreset/user-models.txt.

export OPENPRESET_DEFAULT_MODELS="openrouter/auto
cohere/north-mini-code
deepseek/deepseek-v4-flash"

# ── Model selection ──────────────────────────────────────────────────────────

export OPENPRESET_MODEL="__pick__"

# ── Load and run the router ──────────────────────────────────────────────────

export _ROUTER_DIR="${_BRAINING_REPO_DIR}/router"
# shellcheck source=../../router/router_engine.sh
. "${_ROUTER_DIR}/router_engine.sh"
openpreset_router || return 1

# ── Claude behaviour ─────────────────────────────────────────────────────────

export CLAUDE_CODE_DISABLE_ADVISOR_TOOL=1
export CLAUDE_CODE_PLAN_MODE_INTERVIEW_PHASE=1

export SUPERPOWERS_MODIFIER="You are acting EXCLUSIVELY as a Feature Brainstorming and Polishing sparring partner.
- Do NOT generate code, write implementation plans, or invoke TDD tools.
- Your only goal is a conversational debate over feature mechanics, scope creep, and refinement.
- Pull relevant context from the project filesystem to understand the existing project state, but keep the output entirely conversational.
- Challenge my assertions, propose UX/DX polishing ideas, and debate the architectural necessity of the feature."

# ── Launch ────────────────────────────────────────────────────────────────────

if [ "$#" -eq 0 ]; then
    exec claude "/brainstorming"
else
    exec claude "/brainstorming $*"
fi
